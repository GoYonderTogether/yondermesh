{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yondermesh",
  "mainBinaryName": "ymesh",
  "version": "0.1.0",
  "identifier": "app.yondermesh",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @ymesh/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @ymesh/web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yondermesh",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 8,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.productivity",
    "copyright": "© 2026 Yondermesh",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.macos.plist"
    }
  }
}
